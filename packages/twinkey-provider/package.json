{
  "name": "twinkey-provider",
  "version": "0.1.1",
  "description": "EIP-1193 provider that lets an ordinary ss58 key drive Portaldot from viem, wagmi or ethers: reads go to the EVM JSON-RPC, writes become sr25519-signed revive.call extrinsics.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "portaldot",
    "polkadot",
    "substrate",
    "pallet-revive",
    "evm",
    "eip-1193",
    "viem",
    "wagmi",
    "ethers",
    "sr25519",
    "ss58"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memeshee/twinkey.git",
    "directory": "packages/twinkey-provider"
  },
  "homepage": "https://twinkey.vercel.app",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@polkadot/api": "^16.5.6",
    "@polkadot/util-crypto": "^14.0.1",
    "viem": "^2.38.5"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
